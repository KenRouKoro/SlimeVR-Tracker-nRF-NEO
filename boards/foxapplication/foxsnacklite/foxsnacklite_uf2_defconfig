CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

CONFIG_SLIMEVR_USB_DEVICE_MANUFACTURER="FoxApplication"
CONFIG_SLIMEVR_USB_DEVICE_PRODUCT="FoxApplication FoxSnackLite Tracker"

CONFIG_BATTERY_USE_REG_BUCK_MAPPING=y
CONFIG_IGNORE_CHARGE_WAKE_ON_VBUS=y

# vcc-gpios (P1.00) is the enable pin of the external sensor-rail LDO, not a
# switched rail: System OFF must drive it low instead of releasing it (Hi-Z),
# otherwise the EN floats and the rail can stay powered.
CONFIG_VCC_GPIO_IS_ENABLE=y

CONFIG_SENSOR_ROTATION_0=y

#generate for adafruit uf2 bootloader flashing
CONFIG_BUILD_OUTPUT_UF2=y
